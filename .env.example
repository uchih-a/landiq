# ---- Application ----
APP_ENV=development
LOG_LEVEL=DEBUG
PORT=8000

# ---- Artifacts ----
# Directory holding model files, spatial data, and app exports.
# In production this is a mounted volume (read-only).
ARTIFACTS_DIR=./artifacts

# ---- Model versioning (B8) ----
# Which version of the Notebook 3 export is "active" — the ArtifactRegistry
# loads from ARTIFACTS_DIR/models/ensemble/<ACTIVE_MODEL_VERSION>/ at startup.
# Empty = flat layout (dev / CI).  Set to the notebook's production_run name
# (e.g. "Run A") in production.
ACTIVE_MODEL_VERSION=

# ---- CORS ----
# Comma-separated list of allowed origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional regex for Vercel preview URLs (leave empty to disable).
ALLOWED_ORIGINS_REGEX=https://kenya-land-val-.*\.vercel\.app

# ---- Rate limiting (B7) ----
# Per-client rate limit for POST /api/v1/predict, in requests per minute.
# 20 = one prediction every 3s; generous for a human, blocks scraping.
PREDICT_RATE_LIMIT_PER_MINUTE=20
# Redis URL for shared rate-limit storage across multiple Railway replicas.
# Empty = in-memory (single replica only).  Set to redis://... before scaling.
REDIS_URL=
